<Application x:Class="MemoLite.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="ShellStrokeBrush" Color="#E4E7EC" />
                    <SolidColorBrush x:Key="ShellSecondaryTextBrush" Color="#78818E" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="#396BBA" />
                    <SolidColorBrush x:Key="ShellSelectedBrush" Color="#E8EFFA" />
                    <SolidColorBrush x:Key="ShellMutedFillBrush" Color="#F1F4F8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#25272D" />
                    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#202228" />
                    <SolidColorBrush x:Key="ShellStrokeBrush" Color="#393D46" />
                    <SolidColorBrush x:Key="ShellSecondaryTextBrush" Color="#9DA5B3" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="#A2C2FF" />
                    <SolidColorBrush x:Key="ShellSelectedBrush" Color="#303E58" />
                    <SolidColorBrush x:Key="ShellMutedFillBrush" Color="#2D313A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SidebarRowStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="SidebarSectionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource ShellSecondaryTextBrush}" />
                <Setter Property="Margin" Value="12,0,0,8" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style x:Key="EditorMenuDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="MemoEditorStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Malgun Gothic" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="28,24" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="{ThemeResource EditorSurfaceBrush}" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
